# ============================================
# AirPool Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://airpool_admin:airpool_secret_2024@localhost:27017/airpool?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=airpool_redis_2024

# JWT Secrets (generate strong random strings for production)
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption
ENCRYPTION_KEY=32_char_encryption_key_change_me!

# RabbitMQ
RABBITMQ_URL=amqp://airpool:airpool_rabbit_2024@localhost:5672

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=airpool_minio
MINIO_SECRET_KEY=airpool_minio_2024
MINIO_BUCKET=airpool-uploads
MINIO_USE_SSL=false

# OTP (Twilio or MSG91 for production)
OTP_SERVICE=console
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# OCR (Tesseract - local, no API key needed)
OCR_ENGINE=tesseract

# Admin Credentials (change immediately after first login)
ADMIN_EMAIL=admin@airpool.app
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:19006,exp://localhost:19000

# Push Notifications (Expo)
# EXPO_ACCESS_TOKEN=your_expo_token

# Flight Status API (optional - AviationStack free tier)
# AVIATION_STACK_API_KEY=your_key
