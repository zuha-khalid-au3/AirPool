# ============================================
# AirPool Mobile - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Local development (default) ---
# localhost works in iOS Simulator / Android emulator.
# For a physical device on the same Wi-Fi, use your Mac's LAN IP instead.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Socket.io URL
# Example: EXPO_PUBLIC_SOCKET_URL=http://192.168.1.42:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# --- Remote development (outside your network) ---
# When sharing the app via Expo tunnel, set these to your PUBLIC backend URL
# (from ngrok, cloudflared, or a deployed server). Do not use localhost.
# Example:
# EXPO_PUBLIC_API_BASE_URL=https://abc123.ngrok-free.app/api/v1
# EXPO_PUBLIC_SOCKET_URL=https://abc123.ngrok-free.app
#
# Or run without editing .env (from project root):
# AIRPOOL_PUBLIC_API_URL=https://YOUR-FULL-PUBLIC-URL make dev-remote
# Or from packages/mobile:
# AIRPOOL_PUBLIC_API_URL=https://YOUR-FULL-PUBLIC-URL yarn dev:remote
#
# Expose backend first: make tunnel-backend
# (uses cloudflared by default; no account required)

# Environment
APP_ENV=development
