# ============================================
# AirPool Mobile - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# API Base URL (your backend server)
# Use your Mac's LAN IP when testing on a physical device (localhost only works in simulator)
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Socket.io URL
# Example: EXPO_PUBLIC_SOCKET_URL=http://192.168.1.42:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Environment
APP_ENV=development
