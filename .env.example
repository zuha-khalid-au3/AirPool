# ============================================
# AirPool - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================

# App Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/airpool
MONGODB_DB_NAME=airpool

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Twilio (SMS OTP) - Replace with Fonoster for open-source alternative
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MinIO (S3-Compatible Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=airpool-uploads
MINIO_USE_SSL=false

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Socket.io
SOCKET_CORS_ORIGIN=*

# Flight Status API (AviationStack - free tier)
AVIATION_STACK_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin Panel
ADMIN_EMAIL=admin@airpool.app
ADMIN_PASSWORD=changeme123

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key!
ENCRYPTION_IV=your-16-char-iv!

# GrowthBook Feature Flags
GROWTHBOOK_API_HOST=http://localhost:3100
GROWTHBOOK_CLIENT_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
